{
  "name": "cafe-pos-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "tsc -p . && tsc -p server",
    "build": "tsc -p . && tsc -p server && vite build",
    "preview": "vite preview",
    "hub": "node server/hub.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:kitchen": "vitest run tests/kitchen-flow",
    "test:access": "vitest run tests/access",
    "test:qr": "vitest run tests/customer-lines",
    "test:loss": "vitest run tests/loss-report",
    "test:merge": "vitest run tests/merge-order",
    "test:stations": "vitest run tests/kitchen-stations",
    "test:refund": "vitest run tests/refunds",
    "test:takeaway": "vitest run tests/takeaway"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
