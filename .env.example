# Supabase (bulutda sinxronlash). Ikkala qiymat ham Supabase Dashboard -> Project Settings -> API sahifasida.
# Bu faylni ".env.local" nomi bilan nusxalang va qiymatlarni yozing. ".env.local" GitHub'ga yuklanmaydi.
# Qiymatlar bo'sh bo'lsa, dastur avvalgidek faqat shu qurilmada ishlaydi.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Kafe mahalliy serveri (npm run hub), qo'llanma: MAHALLIY-SERVER.md. Faqat server kompyuterida kerak.
# Qurilmalar serverga ulanishi uchun parol (kamida 8 belgi):
HUB_PASSWORD=
# Server bulut bilan ham sinxronlansin (ixtiyoriy): SUPABASE.md 3-qadamdagi kafe hisobi
HUB_SUPABASE_EMAIL=
HUB_SUPABASE_PASSWORD=
# Port (standart 8080) va ma'lumotlar papkasi (standart hub-data)
# HUB_PORT=8080
# HUB_DATA_DIR=hub-data
